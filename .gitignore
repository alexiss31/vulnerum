# Runtime artifacts generated by `custos run`, `custos detect` and `custos report`.
# Small curated fixtures live in labs/<cve>/fixtures/ and tests/fixtures/ and are tracked.
artifacts/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Test and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Secrets and keys (never commit)
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Logs
*.log
